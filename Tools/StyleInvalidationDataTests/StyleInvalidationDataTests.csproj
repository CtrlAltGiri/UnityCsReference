<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Standalone harness for the engine-independent StyleInvalidationData tests:
    compiles the real selector/invalidation sources against minimal engine stubs.
    Run with: dotnet test Tools/StyleInvalidationDataTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="..\..\Modules\UIElements\Core\StyleSheets\StyleInvalidationData.cs" />
    <Compile Include="..\..\Modules\UIElements\Core\StyleSheets\StyleSelector.cs" />
    <Compile Include="..\..\Modules\UIElements\Core\StyleSheets\StyleSelectorPart.cs" />
    <Compile Include="..\..\Modules\UIElements\Core\StyleSheets\StyleSelectorType.cs" />
    <Compile Include="..\..\Modules\UIElements\Core\StyleSheets\StyleSelectorRelationship.cs" />
    <Compile Include="..\..\Modules\UIElements\Tests\StyleSheets\StyleInvalidationDataTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
